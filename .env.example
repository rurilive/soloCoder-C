OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 向量维度由模型决定，无需手动配置
# OpenAI text-embedding-3-small: 1536 维
# OpenAI text-embedding-3-large: 3072 维 (可调整)
# 第三方模型请查看其文档确认维度
# EMBEDDING_DIMENSIONS=1536

# ==================== 向量搜索配置 ====================
# 每次搜索返回的最大结果数量
VECTOR_SEARCH_TOP_K=20

# 相似度阈值（0.0 ~ 1.0）
# 只有相似度 >= 此值的结果才会被返回
# 0.0: 返回所有结果（默认）
# 0.3: 低阈值，返回更多结果
# 0.5: 中等阈值
# 0.7: 高阈值，只返回高度相关的结果
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.0

# ==================== 应用配置 ====================
# 每页显示的照片数量
PAGE_SIZE=12

# 上传目录
UPLOAD_DIR=uploads

# 日志目录
LOG_DIR=logs

# 初始用户的 token（用于首次启动时创建）
INITIAL_TOKEN=aaaa
