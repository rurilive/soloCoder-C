# 应用配置
APP_NAME=租房管理系统
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./rental.db
# PostgreSQL配置示例
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rental_db

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件上传配置
UPLOAD_DIR=./app/static/uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# 短信服务配置（可选）
SMS_ACCESS_KEY_ID=your_access_key
SMS_ACCESS_KEY_SECRET=your_access_secret
SMS_SIGN_NAME=您的签名
SMS_TEMPLATE_CODE=SMS_123456

# 邮件服务配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@example.com

# 云存储配置（可选，默认使用本地存储）
STORAGE_TYPE=local
# OSS配置
# OSS_ACCESS_KEY_ID=your_access_key
# OSS_ACCESS_KEY_SECRET=your_access_secret
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your-bucket-name

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
